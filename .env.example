# Example environment. Do not copy real values into any file in this repo.
# With Aiven: `source scripts/aiven-env.sh` exports DATABASE_URL and VALKEY_URL for you.
# Offline:    `make up-local` sets them to the local containers.

DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/defaultdb?sslmode=require
VALKEY_URL=rediss://default:PASSWORD@HOST:PORT
ANTHROPIC_API_KEY=

# Optional overrides
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=high
# Vision model for the on-demand Upscale pass (D-027); the cheapest capable one by default
UPSCALE_MODEL=claude-haiku-5-5
# Sketch redraw of raster image pages (D-028): a stronger model, a few check rounds
SKETCH_MODEL=claude-opus-5-5
SKETCH_EFFORT=high
SKETCH_MAX_ROUNDS=3
# Seconds per model call, and after which no new check round starts
SKETCH_TIMEOUT_S=300
SKETCH_DEADLINE_S=600
# off | exact | all: which recognised questions the server answers without the agent (D-038)
FAST_PATH=exact
# The model that sorts questions for the fast path; unset: the agent's model
ROUTER_MODEL=
