# Serves the built UI and proxies /api to the backend (D-033).
# The nginx image fills ${...} from the environment at start-up (Dockerfile sets defaults):
#   BACKEND_URL            where /api goes; http://backend:8000 in Docker Compose
#   NGINX_LOCAL_RESOLVERS  the container's DNS servers, read from /etc/resolv.conf
# With the address in a variable nginx resolves it per request (cached 10 s), so it
# starts without a backend and follows a recreated backend container (#64).
server {
  listen 80;
  root /usr/share/nginx/html;
  client_max_body_size 200m;
  resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

  location /api/ {
    set $backend ${BACKEND_URL};
    # A variable with no path after the host passes the request URI through unchanged.
    proxy_pass $backend;
    proxy_http_version 1.1;
    # The backend's own host name, so an HTTPS backend behind a router gets its request.
    proxy_ssl_server_name on;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
    # Server-sent events (/api/events, /api/ask) must not be buffered.
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 1h;
  }

  location / {
    try_files $uri /index.html;
  }
}
